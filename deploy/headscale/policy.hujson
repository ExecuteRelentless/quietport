// Quietport mesh policy (FR-81/82/83). Regenerated by qp-hub from the person/household tables and pushed with
// `headscale policy set`. Default posture: every device may reach the hub; devices may not reach each other.
{
  "groups": {
    // qp-hub fills one group per household: "group:household-<name>": ["alice@", "bob@"]
  },
  "tagOwners": {
    "tag:hub": ["hub@"]
  },
  "acls": [
    { "action": "accept", "src": ["*"], "dst": ["tag:hub:*"] }
  ]
}
