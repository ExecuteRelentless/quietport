[Unit]
Description=Quietport hub (invite service, agent API, TLS front for headscale)
After=network-online.target headscale.service
Wants=network-online.target

[Service]
User=quietport
Group=quietport
EnvironmentFile=/etc/quietport/hub.env
ExecStart=/usr/local/bin/qp-hub serve
Restart=always
RestartSec=3
# bind :443 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
